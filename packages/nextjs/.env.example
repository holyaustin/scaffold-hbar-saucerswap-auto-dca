# Copy to .env.local (or run `npm run setup` from the repo root). Never commit .env.local.

# Which Hedera network the app talks to. Only "testnet" is live; "mainnet" shows a coming-soon notice.
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Optional: use a vault you deployed elsewhere. `npm run hardhat:deploy` fills lib/deployments.json for you.
NEXT_PUBLIC_VAULT_ADDRESS=0x...

# Server-side only (never prefix with NEXT_PUBLIC_). Pyth's Hermes API now needs a key:
# https://docs.pyth.network/price-feeds/core/upgrade/preparing
# Without it the app still works; it just cannot push fresh prices on-chain, so runs rely on prices
# that someone else already published.
PYTH_API_KEY=3Y1o6GfcAUzW8irqfLWvBT3X8WRHNUfti9grDcJxBTCc
PYTH_HERMES_URL=https://hermes.pyth.network

# Optional: show a link to your HCS audit topic. `npm run hardhat:audit-relay` records it for you.
# NEXT_PUBLIC_HCS_TOPIC_ID=0.0.12345
