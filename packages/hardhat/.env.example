# Copy to .env (or run `npm run setup` from the repo root). Never commit .env.

# Hex-encoded ECDSA private key of the account that deploys and pays gas.
# Get one from https://portal.hedera.com (choose an ECDSA account) or run `npm run hardhat:account`.
DEPLOYER_PRIVATE_KEY=

# Optional overrides
# HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
# SCHEDULED_CALL_GAS_LIMIT=2000000
# MIN_INTERVAL_SECONDS=60
# FUND_HBAR=5

# Demo plan (used by `npm run hardhat:demo-plan`)
# EVM addresses of two HTS tokens that share a SaucerSwap V2 pool on testnet.
# TOKEN_IN=0x...
# TOKEN_OUT=0x...
# POOL_FEE=3000
# AMOUNT_PER_RUN=1
# RUNS=3
# INTERVAL_SECONDS=120
# MAX_SLIPPAGE_BPS=500
# MAX_CONF_BPS=200
# MAX_PRICE_AGE=3600
# Pyth feed IDs (USD pairs). Confirm at https://docs.pyth.network/price-feeds/core/price-feeds/price-feed-ids
# PRICE_ID_IN=0x...
# PRICE_ID_OUT=0x...

# Optional HCS audit relay (`npm run hardhat:audit-relay`)
# Your Hedera account ID (the one that owns DEPLOYER_PRIVATE_KEY), for example 0.0.12345
# HEDERA_ACCOUNT_ID=
# Reuse an existing topic instead of creating one
# HCS_TOPIC_ID=
# Keep running and publish new events as they happen
# RELAY_WATCH=true
# RELAY_INTERVAL_SECONDS=30
